{
  "family": "wordpress-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "",
  "taskRoleArn": "",
  "containerDefinitions": [
    {
      "name": "wordpress",
      "image": "REPLACE_ME",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "WORDPRESS_DB_HOST",
          "value": "REPLACE_WITH_RDS_ENDPOINT"
        },
        {
          "name": "WORDPRESS_DB_USER",
          "value": "wp_user"
        },
        {
          "name": "WORDPRESS_DB_PASSWORD",
          "value": "REPLACE_ME"
        },
        {
          "name": "WORDPRESS_DB_NAME",
          "value": "contentpress_db"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/wordpress-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
